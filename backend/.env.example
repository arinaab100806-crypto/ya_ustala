# Секрет для подписи токенов входа. Замените перед любым общим запуском.
SECRET_KEY=codearena-dev-secret-key-change-me

# Необязательный путь к файлу SQLite.
# DATABASE_PATH=codearena.db

# Если JUDGE0_URL пустой, проверка кода недоступна и вердикты не выставляются.
# Пример RapidAPI:
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
#
# Пример своего Judge0:
# JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Первый администратор создаётся только если администраторов ещё нет.
# Не заполняйте эти поля в общем репозитории.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please

# JUDGE0_LANG_PYTHON=71
# JUDGE0_LANG_CPP=54
# JUDGE0_LANG_JAVA=62
# JUDGE0_LANG_JAVASCRIPT=63

# Шрифт с кириллицей для PDF-отчёта. На Windows по умолчанию используется Arial.
# REPORT_FONT=C:\Windows\Fonts\arial.ttf
